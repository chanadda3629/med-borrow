# PostgreSQL connection string (Neon free tier in production, local Postgres in dev)
DATABASE_URL="postgresql://user:password@localhost:5432/medborrow"

# Auth.js (NextAuth) session secret — generate with `npx auth secret`
AUTH_SECRET=""

# LINE Messaging API (push notifications + webhook)
LINE_CHANNEL_ACCESS_TOKEN=""
# Messaging API channel secret — used to verify incoming webhook signatures at /api/line/webhook
LINE_CHANNEL_SECRET=""
# LINE Login channel ID — used for the "Connect LINE" account-linking QR flow at /api/line/link/start
LINE_LOGIN_CHANNEL_ID=""

# OpenRouter (AI equipment recommendation)
OPENROUTER_API_KEY=""

# Cloudinary (media uploads)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
